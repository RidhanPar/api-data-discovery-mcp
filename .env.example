# Copy to .env for local overrides. Never commit .env.
NORDLYS_DATABASE_URL=postgresql+psycopg://nordlys:nordlys@localhost:5432/nordlys
NORDLYS_EMBEDDING_PROVIDER=onnx-local
# NORDLYS_EMBEDDING_MODEL_DIR=~/.cache/nordlys-models/bge-small-en-v1.5-onnx-q
